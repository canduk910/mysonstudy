// firestore.rules — 클라이언트 SDK 접근 전면 거부 (2026-11-25)
//
// 이 앱은 브라우저에서 Firestore를 직접 읽거나 쓰지 않는다. 모든 데이터 접근은 Cloud Run 서버가
// Admin SDK(서비스 계정)로 하며, Admin SDK는 보안 규칙을 **우회**한다 — 그래서 이 파일이
// deny-all이어도 앱 동작에는 영향이 없다. 목적은 Firebase 웹 설정이 새거나 누가 클라이언트 SDK로
// 프로젝트에 붙어도 가족 데이터를 읽고 쓰지 못하게 하는 것이다.
//
// 배포(2026-11-26): firebase.json "firestore.rules"에 연결했고, 같은 날 Firebase Rules API로 한 번 반영했다
// (그 전에는 규칙 릴리스가 한 번도 없었다 — 클라이언트 접근은 기본 거부 상태였다). CI는 hosting만 배포하므로
// 이 파일을 고치면 `firebase deploy --only firestore:rules --project eunwoo-bookcard`를 사람이 실행해야 반영된다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
