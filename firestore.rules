// firestore.rules — 클라이언트 SDK 접근 전면 거부 (2026-11-25)
//
// 이 앱은 브라우저에서 Firestore를 직접 읽거나 쓰지 않는다. 모든 데이터 접근은 Cloud Run 서버가
// Admin SDK(서비스 계정)로 하며, Admin SDK는 보안 규칙을 **우회**한다 — 그래서 이 파일이
// deny-all이어도 앱 동작에는 영향이 없다. 목적은 Firebase 웹 설정이 새거나 누가 클라이언트 SDK로
// 프로젝트에 붙어도 가족 데이터를 읽고 쓰지 못하게 하는 것이다.
//
// ⚠️ 이 파일은 아직 **배포에 연결돼 있지 않다**(firebase.json·.github/workflows에 연결하지 않음).
// 실제 반영은 사용자 결정이다 — 반영하려면 firebase.json에 "firestore": { "rules": "firestore.rules" }를
// 넣고 `firebase deploy --only firestore:rules --project eunwoo-bookcard`를 한 번 실행한다.
// 반영 전에 콘솔의 현재 규칙을 먼저 확인할 것(기본 "테스트 모드"였다면 지금 열려 있을 수 있다).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
