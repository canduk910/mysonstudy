# 은우 북카드 환경 변수 (SPEC §11) — 실제 키는 커밋 금지, .env.local에 두세요
OPENAI_API_KEY=      # 필수. 서버 전용 — 클라이언트 번들에 절대 노출 금지
OPENAI_MODEL=        # 선택. 미설정 시 기본값 gpt-5.5 (비전+Structured Outputs 지원 최신 모델, OpenAI 문서 확인)
GOOGLE_BOOKS_API_KEY= # 선택. 없으면 무키 호출(저볼륨 가능)
GOOGLE_APPLICATION_CREDENTIALS= # 로컬 개발용 Firestore 인증. Cloud Run에서는 서비스 계정 ADC 사용
# ⚠️ 로컬에서는 비워 두거나 file로 두세요. firestore로 두면 **로컬 실행이 프로덕션 DB를 직접 씁니다.**
#  · 2026-08-17: 이 값이 firestore라 로컬 삭제 테스트가 가족 데이터를 전부 지웠습니다(1시간 보존 창으로 겨우 복구).
#  · GOOGLE_CLOUD_PROJECT나 GOOGLE_APPLICATION_CREDENTIALS만 있어도 자동 감지가 firestore를 고릅니다 — 로컬에선 그것도 비워 두세요.
#  · Cloud Run은 K_SERVICE 감지로 알아서 Firestore를 쓰므로 배포에는 아무 설정이 필요 없습니다.
#  · 삭제는 lib/prod-guard.ts가 개발 환경에서 막지만, 생성·수정은 그대로 통합니다.
STORE_BACKEND=          # 선택. firestore|file — 미설정 시 자동 감지(GCP 자격증명 있으면 firestore, 없으면 file)
# 접속 잠금 PIN — 서버 전용(숫자 6~8자리 권장, 최소 4자리). 도메인이 공개돼도 가족 외 접속과 AI 비용 유출을 막는다.
#  · 4자리는 경우의 수가 1만뿐이라 짧다 — 시도 제한이 있어도 6자리 이상을 권한다
#  · 프로덕션(NODE_ENV=production)에서 미설정 → 전부 차단(fail-closed). 열린 채 방치되는 것보다 안전
#  · 개발(로컬)에서 미설정 → 잠금 없이 통과(데모 그대로)
#  · PIN을 바꾸면 기존 잠금 쿠키는 자동 무효화된다(서명 키가 PIN이므로)
APP_PIN=                # 예: 246813
